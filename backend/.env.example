NODE_ENV=development
PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Delivery Configuration
# Recommended for Render Free Tier (bypasses SMTP port blocks using HTTPS Port 443):
RESEND_API_KEY=your_resend_api_key_from_resend_com

# Or Traditional SMTP (works on localhost or paid cloud hosting):
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
FRONTEND_URL=http://localhost:5173

# Optional: Python AI Service URL (defaults to localhost:8000 if not set)
AI_SERVICE_URL=http://localhost:8000